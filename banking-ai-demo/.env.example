# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Các service đọc thẳng từ biến môi trường, không có file cấu hình nào khác.

# --- Database ------------------------------------------------------------
# Một trong hai cách, DATABASE_URL được ưu tiên nếu có cả hai.
DATABASE_URL=postgresql://anhnv20:PASSWORD@DB_HOST:5432/ea-hackathon?sslmode=require
# PGHOST=
# PGPORT=5432
# PGUSER=anhnv20
# PGPASSWORD=
# PGDATABASE=ea-hackathon
# PGSSLMODE=require

DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_TIMEOUT=10

# --- Địa chỉ các service ---------------------------------------------------
# 5 service chạy độc lập nên phải khai báo địa chỉ thật của từng cái.
# Trên GreenNode: điền URL công khai của mỗi service.
# Trong Kubernetes cùng namespace: dùng tên service, ví dụ http://transaction-service
CUSTOMER_PROFILE_SERVICE_URL=http://customer-profile-service
TRANSACTION_SERVICE_URL=http://transaction-service
RISK_SCORING_SERVICE_URL=http://risk-scoring-service
SCAM_KNOWLEDGE_SERVICE_URL=http://scam-knowledge-service
ACTION_FEEDBACK_SERVICE_URL=http://action-feedback-service

# Thời gian chờ tối đa khi gọi sang service khác (giây).
PEER_TIMEOUT_SECONDS=5

# --- Swagger ---------------------------------------------------------------
# Địa chỉ công khai của CHÍNH service này. Đặt giá trị khi service đứng sau
# ingress hoặc reverse proxy, để nút "Try it out" trên Swagger gọi đúng địa chỉ.
# PUBLIC_BASE_URL=https://customer-profile.example.greennode.vn
